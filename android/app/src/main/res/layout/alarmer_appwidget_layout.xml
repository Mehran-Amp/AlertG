<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_dark"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Header Bar with Check All Action -->
    <LinearLayout
        android:id="@+id/widget_header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="5dp">

        <ImageView
            android:id="@+id/widget_logo_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alarmer Live"
                android:textColor="#F9FAFB"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active Alerts"
                android:textColor="#9CA3AF"
                android:textSize="8.5sp" />
        </LinearLayout>

        <!-- Check All Action Button in Header -->
        <TextView
            android:id="@+id/widget_refresh_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_live_pill_dark"
            android:gravity="center"
            android:minHeight="28dp"
            android:paddingLeft="9dp"
            android:paddingStart="9dp"
            android:paddingTop="4dp"
            android:paddingRight="9dp"
            android:paddingEnd="9dp"
            android:paddingBottom="4dp"
            android:text="⟳ Check All"
            android:textColor="#10B981"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_divider_1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="4dp"
        android:background="#21262D" />

    <!-- Scrollable ListView for all alerts -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/widget_listview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="vertical" />

        <!-- Empty state when no alerts exist -->
        <TextView
            android:id="@+id/widget_empty_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="No active alerts configured"
            android:textColor="#9CA3AF"
            android:textSize="10sp"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_divider_2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        android:background="#21262D" />

    <!-- Footer -->
    <TextView
        android:id="@+id/widget_footer_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.5dp"
        android:gravity="center"
        android:text="Tap to open Alarmer"
        android:textColor="#10B981"
        android:textSize="8sp" />
</LinearLayout>
