# ==========================================
# GlobalSTK Server Configuration (.env)
# ==========================================

# --- Security & Access Keys ---
# Shared secret key used by mobile apps (header: X-API-Key)
API_KEY=your_mobile_api_key_here

# Operator admin key for /admin/*, /metrics, /probe, /debug/* (header: X-Admin-Key)
ADMIN_KEY=your_secret_admin_key_here

# Optional: Allowed CORS origins separated by comma (e.g. https://example.com,http://localhost:3000)
CORS_ORIGINS=

# --- Server Host & Port ---
HOST=0.0.0.0
PORT=8000

# --- Market Data Providers (Optional / Recommended for High Volume) ---
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
FRED_API_KEY=

# --- Iran Bridge Configuration ---
# Bridge URL on Iran host (default: https://aegkala.com/market-bridge.php)
IRAN_BRIDGE_URL=https://aegkala.com/market-bridge.php
# Secret token for bridge authorization
SIGNALALERT_BRIDGE_TOKEN=

# --- Telegram Notifications & Admin Alerts ---
# Bot token for sending user alert notifications
TELEGRAM_BOT_TOKEN=
# Chat ID for operational admin alerts (e.g. provider outages, delistings)
TELEGRAM_ADMIN_CHAT_ID=

# --- Firebase Push Notifications ---
# Path to service account key file (default: ./serviceAccountKey.json)
# Or provide the entire JSON string in FIREBASE_SERVICE_ACCOUNT
# FIREBASE_SERVICE_ACCOUNT=

# --- Rollout & Feature Flags ---
# Comma-separated list of beta user IDs
BETA_USER_IDS=

# Feature flags: FEATURE_FLAG_<FLAG_NAME>=true|false
FEATURE_FLAG_CANARY_ROLLOUT=false
FEATURE_FLAG_EXPERIMENTAL_PROVIDERS=false

# --- Kill Switches (Circuit Breakers) ---
# Disable specific providers: e.g. yahoo, twelvedata, nobitex
KILL_SWITCH_PROVIDERS=
# Disable specific categories: e.g. crypto, forex, iran, macro
KILL_SWITCH_CATEGORIES=
